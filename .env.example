OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# Local development only; replace this password in your untracked .env.
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_PORT=55432
POSTGRES_DB=troubleshooter
# URLs must use the same password as POSTGRES_PASSWORD (URL-encode special characters).
DATABASE_URL=postgresql+asyncpg://troubleshooter:replace-with-a-local-password@127.0.0.1:55432/troubleshooter
CHECKPOINT_DATABASE_URL=postgresql://troubleshooter:replace-with-a-local-password@127.0.0.1:55432/troubleshooter
# Integration tests create/drop uniquely named databases; never point this at production.
TEST_DATABASE_URL=postgresql://troubleshooter:replace-with-a-local-password@127.0.0.1:55432/troubleshooter_test

# Phase 9: fail closed by default. Set to development ONLY for explicit local mocks.
APP_ENV=production
# Comma-separated authenticated application subject UUIDs; empty means no admins.
REGISTRY_ADMIN_IDS=
REGISTRY_DEVELOPMENT_MOCK_ORIGIN=http://127.0.0.1:8001

# Phase 10: disabled by default; use a trusted authentication adapter in production.
DEMO_AUTH_ENABLED=false
DEMO_SUBJECT_ID=
# Generate locally with: python -c 'import secrets; print(secrets.token_urlsafe(32))'
DEMO_AUTH_TOKEN=
# Exact frontend origins only, comma-separated. Empty disables cross-origin access.
CORS_ORIGINS=http://localhost:5173

# Phase 11: enable durable submission only after migration 0004 and worker setup.
DURABLE_WORKER_ENABLED=false

# Optional production identity metadata. Server composition must also inject
# trusted key and revocation authorities; metadata alone does not enable login.
# IDENTITY_ISSUER=https://your-identity-provider.example.invalid
# IDENTITY_AUDIENCE=your-registered-audience

# Phase 14.5: defaults OFF. This flag supplies no providers or authorization.
# Enabling without trusted server composition fails closed.
DIAGNOSTIC_CONTRACTS_ENABLED=false
